{
  "name": "honest-returns",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "honest-returns", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["0 22,23,0-7 * * *"] }
}
